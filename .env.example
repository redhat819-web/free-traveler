# Free Traveler 환경변수 예시 — 실제 값은 넣지 않는다. Vercel 환경변수 설정 시 이 목록을 기준으로 한다.

# Supabase 프로젝트 URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (Publishable key 아님 — src/lib/db/env.ts가 읽는 이름)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 사이트 절대 URL(metadataBase, OG 태그 생성용)
NEXT_PUBLIC_SITE_URL=

# Playwright가 Preview/배포된 URL을 대상으로 테스트할 때만 설정(선택, 로컬 dev는 비워둔다)
PLAYWRIGHT_BASE_URL=

# E2E-MATE-AUTH용 테스트 계정(이메일 확인 완료된 계정 2개, 작성자/참가자)
PLAYWRIGHT_TEST_USER_EMAIL=
PLAYWRIGHT_TEST_USER_PASSWORD=
PLAYWRIGHT_TEST_USER2_EMAIL=
PLAYWRIGHT_TEST_USER2_PASSWORD=

# 사용하지 않음 — CLAUDE.md 규칙 14(RLS 우회 조회 금지)·15(Service Role Key는 서버 전용,
# Client 번들 포함 금지). 이 프로젝트 코드는 어디에서도 Service Role Key를 읽지 않는다.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --passWithNoTests",
    "task:contract": "python scripts/audit_tasks.py",
    "screen:contract": "python scripts/check_screen_contract.py",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test tests/e2e/public-smoke.spec.ts",
    "validate": "python scripts/validate_inputs.py && python scripts/validate_harness.py && npm run task:contract && npm run screen:contract -- --mode=plan",
    "ci": "npm run clean && npm run build && npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run task:contract && npm run screen:contract -- --mode=ci",
    "release:check": "npm run ci && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
